# Copy this file to .env and fill real credentials. Do NOT commit .env to source control.

# Backend port (optional)
PORT=5001

# API base for frontend builds (optional) e.g. https://api.example.com
VITE_API_BASE_URL=

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/kalavedika

# JWT secret for admin authentication
JWT_SECRET=your_jwt_secret_here

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongAdminPassword123!
ADMIN_EMAIL=admin@example.com

# SMTP settings - fill with your SMTP provider details
# For Gmail with App Passwords use:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Notes:
# - After filling .env, restart the backend: npm run server
# - If SMTP is not configured, the server will create an Ethereal test account and provide preview URLs for emails (development only).
# - Do not commit real credentials into the repository. Use environment variables on your deployment platform instead.
